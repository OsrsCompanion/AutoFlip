[Unit]
Description=AutoFlip collector diagnostic scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=osrscompanion
Group=osrscompanion
WorkingDirectory=/home/osrscompanion/osrs-flip-assistant
Environment=PYTHONPATH=/home/osrscompanion/osrs-flip-assistant
Environment=OSRS_FLIP_DATA_ROOT=/mnt/nvme/autoflip-data
ExecStart=/home/osrscompanion/osrs-flip-assistant/venv/bin/python3 -m app.services.collector_diagnostics scan-loop --interval-seconds 30
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
